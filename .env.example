# ─────────────────────────────────────────────────────────────
# Hestia · Variables de entorno
#   cp .env.example .env   y llena lo que vayas a usar.
#   NUNCA subas .env a git (ya está en .gitignore).
#   Genera claves aleatorias con:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# ── Obligatorias (fase 1) ─────────────────────────────────────
# Modelos (Claude, Gemini y cientos más) con una sola key: https://openrouter.ai/keys
# Ponle un tope de gasto a la key en su panel.
OPENROUTER_API_KEY=
# Clave interna del router LiteLLM (inventa una larga y aleatoria)
LITELLM_MASTER_KEY=sk-hestia-cambia-esto
# Clave de la API de Hestia (la usa Home Assistant para hablar con el cerebro)
HESTIA_API_KEY=cambia-esto-por-algo-largo-y-aleatorio

# ── Telegram (fase 1) ─────────────────────────────────────────
# Bot: habla con @BotFather → /newbot. Tu ID: habla con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Destino por defecto de los cron (tu chat ID)
TELEGRAM_HOME_CHANNEL=

# ── WhatsApp (opcional) ───────────────────────────────────────
# Recomendado: Cloud API oficial de Meta (soporta notas de voz)
# WHATSAPP_ENABLED=true
# WHATSAPP_ALLOWED_USERS=57300XXXXXXX
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_APP_SECRET=
# WHATSAPP_CLOUD_VERIFY_TOKEN=

# ── Modelos ───────────────────────────────────────────────────
# Opcional: API de Anthropic directa en vez de OpenRouter (cambia los alias en config/litellm/config.yaml)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo local (profile local). Con 8 GB VRAM: qwen3.5:4b | gemma4:e4b. Con 24 GB: qwen3.6:27b
OLLAMA_MODEL=qwen3.5:4b
# Si Ollama corre fuera del compose (p. ej. en tu PC con GPU y el resto en un VPS):
# OLLAMA_API_BASE=http://100.x.y.z:11434

# ── Claude Code con tu suscripción (opcional) ─────────────────
# El token NO va aquí: guárdalo con ./scripts/claude-code-login.sh (docs/03-configuracion.md).
# Carpeta con tus proyectos de código, montada en /workspace para que Claude Code trabaje en ellos.
# Windows: usa barras normales, p. ej. C:/Users/tu-usuario/proyectos
HESTIA_WORKSPACE=./workspace

# ── Home Assistant (fase 2) ───────────────────────────────────
# Usuario NO administrador 'hestia' → Perfil → Seguridad → Tokens de larga duración
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=
# Servicio notify para avisos de Hestia en el celular (app Companion)
HASS_HOME_CHANNEL=mobile_app_mi_celular

# ── Voz (profile voice) ───────────────────────────────────────
WHISPER_MODEL=small-int8
WHISPER_LANGUAGE=es
WHISPER_LIBRARY=auto
PIPER_VOICE=es_MX-claude-high
WAKE_WORD_MODEL=hey_jarvis
# Voz premium (la misma voz en ES/EN): https://elevenlabs.io
ELEVENLABS_API_KEY=

# ── Google Workspace (fase 3, profile workspace) ──────────────
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (App de escritorio)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=

# ── GitHub y n8n (fase 3) ─────────────────────────────────────
# Fine-grained PAT de solo lectura: https://github.com/settings/personal-access-tokens
GITHUB_PAT=
N8N_MCP_URL=
N8N_MCP_TOKEN=

# ── Remoto (profile remote) ───────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Versiones fijadas (cámbialas a propósito, nunca "latest" en producción) ──
HERMES_VERSION=v0.21.6
LITELLM_VERSION=v1.98.1
CLAUDE_CODE_VERSION=2.1.296
TZ=America/Bogota
